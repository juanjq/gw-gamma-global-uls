    "      f\"{'shape rms':>9} {'amplitude':>9}\")\n",
    "for row in rows:\n",
    "    s = (f\"{row['theta']:7.2f}° {row['r'].E_iso:8.1e} {row['base'].photon_index:5.2f} | \"\n",
    "         f\"{row['rms_base']:5.2f} dex |\")\n",
    "    if FIT_CATO5:\n",
    "        P = row[\"P_fit\"]\n",
    "        z_th = (np.log10(P.theta_core_deg) - ph.LOG10_THETA_CORE_DEG_MEAN) / ph.LOG10_THETA_CORE_DEG_STD\n",
